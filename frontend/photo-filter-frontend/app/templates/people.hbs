<section class="people-header flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold">People &amp; Pets</h1>
    <p class="text-sm opacity-70">Library-wide view of everyone in Photos.</p>
  </div>

  <div class="sort-controls flex items-center gap-3">
    <label class="text-sm font-semibold" for="people-sort-select">Sort</label>
    <select
      id="people-sort-select"
      data-test-people-sort-select
      class="select select-bordered select-sm"
      {{on "change" this.updateSort}}
      value={{this.sort}}
    >
      {{#each this.sortOptions as |sortOption|}}
        <option
          value={{sortOption.value}}
          selected={{eq sortOption.value this.sort}}
        >
          {{sortOption.label}}
        </option>
      {{/each}}
    </select>

    <button
      type="button"
      class="btn btn-sm"
      data-test-toggle-order
      {{on "click" this.toggleOrder}}
    >
      {{this.orderLabel}}
    </button>
  </div>
</section>

<section class="people-grid grid gap-4 md:grid-cols-2 lg:grid-cols-3">
  {{#each @model as |person|}}
    <People::PersonTile @person={{person}} @sort={{this.sort}} />
  {{/each}}
</section>
